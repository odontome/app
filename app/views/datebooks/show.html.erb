<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", function () {
    function validateSubmit() {
      var submitAppointmentElement = $('#appointment_submit');
      var selectDoctorsElement = $('#appointment_doctor_id');
      submitAppointmentElement.prop('disabled', !selectDoctorsElement.val());
    }

    // FullCalendar runs in UTC as a neutral wall-clock carrier. Rails converts
    // these displayed fields using the practice timezone when reading or saving.
    function calendarTime(date) {
      return date.toISOString().slice(0, 19);
    }

    function calendarLabel(date) {
      return new Intl.DateTimeFormat('<%= I18n.locale %>', {
        day: '2-digit',
        month: 'long',
        hour: 'numeric',
        minute: '2-digit',
        timeZone: 'UTC'
      }).format(date);
    }

    function showAppointmentModal() {
      tabler.Modal.getOrCreateInstance(document.getElementById('modal-appointment')).show();
    }

    var doctorId = <%= params[:doctor_id].present? ? params[:doctor_id].to_i : 'null' %>;
    var endpointURL = '/datebooks/<%= @datebook.id %>/appointments';
    var calendarElement = document.getElementById('calendar');
    var compactCalendar = window.matchMedia('(max-width: 767.98px)').matches;
    var calendar = new FullCalendar.Calendar(calendarElement, {
      initialDate: '<%= Time.zone.today.iso8601 %>',
      now: '<%= Time.current.in_time_zone(@datebook.practice.timezone).strftime('%Y-%m-%dT%H:%M:%S') %>',
      initialView: compactCalendar ? 'timeGridDay' : 'timeGridWeek',
      timeZone: 'UTC',
      slotMinTime: '<%= format('%02d:00:00', @datebook.starts_at) %>',
      slotMaxTime: '<%= format('%02d:00:00', @datebook.ends_at) %>',
      firstDay: 1,
      locales: [{
        code: '<%= I18n.locale %>',
        week: { dow: 1, doy: 4 },
        buttonText: {
          today: '<%= j t(:today) %>',
          month: '<%= j t(:month) %>',
          week: '<%= j t(:week) %>',
          day: '<%= j t(:day) %>'
        }
      }],
      locale: '<%= I18n.locale %>',
      headerToolbar: compactCalendar ?
        { left: 'prev,next', center: 'title', right: 'today' } :
        { left: 'dayGridMonth,timeGridWeek,timeGridDay', center: 'title', right: 'prev,next today' },
      editable: true,
      height: 'auto',
      allDaySlot: false,
      defaultAllDay: false,
      events: function (fetchInfo, successCallback, failureCallback) {
        var query = {
          start: calendarTime(fetchInfo.start),
          end: calendarTime(fetchInfo.end),
          wall_clock: '1'
        };
        if (doctorId) query.doctor_id = doctorId;

        $.getJSON(endpointURL, query)
          .done(successCallback)
          .fail(failureCallback);
      },
      dateClick: function (info) {
        if (info.view.type === 'dayGridMonth') {
          calendar.changeView('timeGridDay', info.date);
          return;
        }

        $.get(endpointURL + '/new', { starts_at: calendarTime(info.date) }, function (data) {
          $('.modal-title').text(calendarLabel(info.date));
          $('.body-container').html(data);
          showAppointmentModal();
          validateSubmit();
        });
      },
      eventClick: function (info) {
        var appointment = info.event;
        var patientId = appointment.extendedProps.patient_id;
        var url = endpointURL + '/' + appointment.id + '/edit?patient_id=' + encodeURIComponent(patientId);

        $.get(url, function (data) {
          $('.modal-title').text(calendarLabel(appointment.start));
          $('.body-container').html(data);
          showAppointmentModal();
          validateSubmit();
        });
      },
      eventDrop: function (info) {
        if (!confirm('<%= j t(:confirm_reschedule) %>')) {
          info.revert();
          return;
        }

        $.ajax({
          type: 'PUT',
          url: endpointURL + '/' + info.event.id,
          data: {
            'appointment[starts_at]': calendarTime(info.event.start),
            'appointment[ends_at]': calendarTime(info.event.end),
            type: 'drop'
          }
        }).fail(info.revert);
      },
      eventResize: function (info) {
        if (!confirm('<%= j t(:confirm_resize) %>')) {
          info.revert();
          return;
        }

        $.ajax({
          type: 'PUT',
          url: endpointURL + '/' + info.event.id,
          data: {
            'appointment[starts_at]': calendarTime(info.event.start),
            'appointment[ends_at]': calendarTime(info.event.end),
            type: 'resize'
          }
        }).fail(info.revert);
      },
      eventDidMount: function (info) {
        var appointment = info.event.extendedProps;
        var patientDisplay = appointment.firstname + ' ' + appointment.lastname;
        if (appointment.patient_uid) patientDisplay += ' (' + appointment.patient_uid + ')';

        var timeElement = info.el.querySelector('.fc-event-time');
        if (timeElement) timeElement.appendChild(document.createTextNode(' ' + patientDisplay));
      }
    });

    calendar.render();
    window.odontomeCalendar = calendar;

    $('#modal-appointment').on('show.bs.modal', function () {
      var doctorSelect = document.getElementById('appointment_doctor_id');
      if (!window.TomSelect || !doctorSelect || doctorSelect.tomselect) return;

      new TomSelect(doctorSelect, {
        copyClassesToDropdown: false,
        dropdownClass: 'dropdown-menu',
        optionClass: 'dropdown-item',
        controlInput: '<input>',
        render: {
          item: function (data, escape) {
            if (data.customProperties) {
              return '<div><span class="dropdown-item-indicator">' + data.customProperties + '</span>' + escape(data.text) + '</div>';
            }
            return '<div>' + escape(data.text) + '</div>';
          },
          option: function (data, escape) {
            if (data.customProperties) {
              return '<div><span class="dropdown-item-indicator">' + data.customProperties + '</span>' + escape(data.text) + '</div>';
            }
            return '<div>' + escape(data.text) + '</div>';
          }
        }
      });
    });

    var refreshInterval = 30_000;
    var refreshTimer;

    function startRefreshCycle() {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(function () {
        calendar.refetchEvents();
        startRefreshCycle();
      }, refreshInterval);
    }

    var userActivityTimeout;
    function pauseRefreshOnActivity() {
      clearTimeout(refreshTimer);
      clearTimeout(userActivityTimeout);
      userActivityTimeout = setTimeout(startRefreshCycle, 5000);
    }

    startRefreshCycle();
    calendarElement.addEventListener('mousedown', pauseRefreshOnActivity);
    calendarElement.addEventListener('touchstart', pauseRefreshOnActivity, { passive: true });
  });
</script>

<!-- Page title -->
<div class="page-header d-print-none">
	<div class="row">
		<div class="col">
			<div id="calendar"></div>

			<div class="row row-cards mt-2">
				<div class="col-md-6 col-xl-3">
					<a href="/" class="card card-link">
						<div class="card-body">
							<div class="row">
								<div class="col-auto">
									<span class="avatar rounded-circle">∞</span>
								</div>
								<div class="col">
									<div class="fw-medium"><%= t :everyone %></div>
									<div class="text-muted"><%= t :all_appointments %></div>
								</div>
							</div>
						</div>
					</a>
				</div>

				<% @doctors.each do |doctor| %>
					<div class="col-md-6 col-xl-3">
						<a href="?doctor_id=<%=doctor.id%>" class="card card-link <%= @filtered_by.to_i == doctor.id ? 'bg-azure-lt' : ''%>">
						<div class="card-body">
							<div class="row">
								<div class="col-auto">
									<%= avatar_for(doctor, variant: :small) %>
								</div>
								<div class="col">
									<div class="fw-medium">
										<%= doctor.fullname %> <span class="badge" style="background-color: <%= doctor.color %>; margin-left: 4px"></span>
									</div>
									<div class="text-muted">
										<%= doctor.speciality.blank? ? "—" : doctor.speciality %>
									</div>
								</div>
							</div>
						</div>
						</a>
					</div>
				<% end %>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="modal-appointment" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t :please_wait %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
		<div class="body-container">
			<%= t :please_wait %>
		</div>
    </div>
  </div>
</div>
