<div class="page page-center"><div class="container container-tight py-4"><div class="card"><div class="card-body">
  <h2 class="card-title text-center mb-3"><%= t(:agent_oauth_authorize_title) %></h2>
  <p class="text-muted"><%= t(:agent_oauth_authorize_description, practice: @authorization.practice.name) %></p>
  <%= form_with url: "/api/agent/oauth/approve", method: :post, local: true do %>
    <%= hidden_field_tag :authorization_id, @authorization.id %><%= hidden_field_tag :approval_token, @approval_token %>
    <%= submit_tag t(:agent_oauth_authorize_button), class: "btn btn-primary w-100" %>
  <% end %>
</div></div></div></div>
