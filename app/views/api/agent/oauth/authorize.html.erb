<div class="card card-md">
  <div class="card-body">
    <h2 class="card-title text-center mb-3"><%= t(:agent_oauth_authorize_description, practice: @authorization.practice.name) %></h2>

    <p>
      <div class="text-muted"><%= t(:agent_oauth_signed_in_as, user: current_user.fullname) %></div>
      <div class="text-muted"><%= t(:agent_oauth_session_description) %></div>
    </p>

    <%= form_with url: "/api/agent/oauth/approve", method: :post, local: true do %>
      <%= hidden_field_tag :authorization_id, @authorization.id %>
      <%= hidden_field_tag :approval_token, @approval_token %>
      <%= submit_tag t(:agent_oauth_authorize_button), class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>

<div class="text-center text-muted mt-3">
  <%= t(:agent_oauth_wrong_account) %>
  <%= button_to t(:signout), logout_path, method: :delete, class: "btn btn-link p-0 align-baseline" %>
</div>
