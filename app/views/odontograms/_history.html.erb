<section class="card mb-3" data-odontogram-history>
  <div class="card-header d-flex justify-content-between flex-wrap gap-2">
    <h2 class="card-title d-flex align-items-center gap-2"><%= odontogram_icon(:history, css: 'icon text-muted') %><%= t('odontogram.history.title') %><% if @history_tooth %><span class="badge bg-secondary-lt"><%= t('odontogram.tooth', number: @history_tooth) %></span><% end %></h2>
    <% if @history_tooth %>
      <%= link_to patient_odontogram_path(@patient, **@history_filters.except(:tooth)), class: 'btn btn-sm btn-ghost-secondary' do %>
        <%= odontogram_icon(:chart) %><%= t('odontogram.history.all_teeth') %>
      <% end %>
    <% end %>
  </div>
  <% if @history_cutoff %>
    <div class="card-body border-bottom" data-history-cutoff>
      <p class="text-muted mb-2"><%= t('odontogram.history.through', time: l(@history_cutoff.created_at, format: :long)) %></p>
      <%= link_to patient_odontogram_path(@patient, at: @history_cutoff.id), class: 'btn btn-sm btn-ghost-primary' do %>
        <%= odontogram_icon(:chart) %><%= t('odontogram.history.view_chart') %>
      <% end %>
    </div>
  <% end %>
  <% if @history_day %>
    <div class="card-body pb-2">
      <%= link_to patient_odontogram_path(@patient, **@history_filters), class: 'btn btn-sm btn-ghost-secondary' do %>
        <%= odontogram_icon(:back) %><%= t('odontogram.history.all_days') %>
      <% end %>
      <h3 class="mt-2 mb-0"><%= l(@history_day, format: :long) %></h3>
    </div>
    <div class="list-group list-group-flush">
      <%= render partial: 'change', collection: @history_changes %>
    </div>
    <% if @history_changes.empty? %><p class="card-body text-muted mb-0"><%= t('odontogram.history.empty') %></p><% end %>
    <% if @earlier_changes %>
      <div class="card-footer"><%= link_to t('odontogram.history.earlier_changes'), patient_odontogram_path(@patient, **@history_filters, history_day: @history_day.iso8601, before_change: @history_changes.last.id) %></div>
    <% end %>
  <% elsif @history_groups.empty? %>
    <p class="card-body text-muted mb-0"><%= t('odontogram.history.empty') %></p>
  <% else %>
    <div class="card-body py-0">
      <% @history_groups.each do |group| %>
        <details class="od-history-group py-3" data-history-day="<%= group[:day].iso8601 %>">
          <summary class="d-flex align-items-center gap-2">
            <%= odontogram_icon(:chevron, css: 'icon od-history-chevron') %>
            <span class="fw-medium"><%= l(group[:day], format: :long) %></span>
            <span class="badge bg-secondary-lt ms-auto"><%= t('odontogram.history.change_count', count: group[:count]) %></span>
          </summary>
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2 mt-sm-3 mb-1 mb-sm-2">
            <% if group[:day] == Date.current && !@history_cutoff %><span class="text-muted small"><%= t('odontogram.history.latest_today') %></span><% end %>
            <%= link_to patient_odontogram_path(@patient, at: group[:changes].first.id), class: 'btn btn-sm btn-ghost-primary ms-auto od-history-chart', title: t('odontogram.history.view_chart'), aria: { label: t('odontogram.history.view_chart') } do %>
              <%= odontogram_icon(:chart) %><span class="d-none d-sm-inline"><%= t('odontogram.history.view_chart') %></span>
            <% end %>
          </div>
          <div class="list-group list-group-flush mt-2"><%= render partial: 'change', collection: group[:changes] %></div>
          <% if group[:count] > 5 %>
            <div class="mt-2"><%= link_to t('odontogram.history.all_changes'), patient_odontogram_path(@patient, **@history_filters, history_day: group[:day].iso8601) %></div>
          <% end %>
        </details>
      <% end %>
    </div>
    <% if @earlier_days %>
      <div class="card-footer"><%= link_to t('odontogram.history.earlier_days'), patient_odontogram_path(@patient, **@history_filters, before_day: @history_groups.last[:day].iso8601) %></div>
    <% end %>
  <% end %>
</section>
