<div class="page-header mb-4" data-odontogram-session="<%= [current_user.id, @patient.practice_id, @patient.id].join(':') %>" data-odontogram-session-enabled="<%= !impersonating? %>">
  <div class="row align-items-center g-2">
    <div class="col">
      <h1 class="page-title"><%= t('odontogram.title') %></h1>
      <div class="text-muted"><%= @patient.fullname %></div>
    </div>
    <div class="col-auto">
      <%= link_to patient_path(@patient), class: 'btn' do %>
        <%= odontogram_icon(:back) %><%= t('odontogram.back_to_patient') %>
      <% end %>
    </div>
  </div>
</div>

<% if @read_only && !@history_cutoff %>
  <div class="alert alert-info" data-odontogram-read-only><%= t('odontogram.read_only') %></div>
<% end %>

<%= render 'history' %>

<% unless @history_cutoff %>
<details class="card od-history-group" data-odontogram-records <%= 'open' if params[:before].present? || (@history_groups.empty? && !@history_day) %>>
  <summary class="card-body d-flex align-items-center gap-2 fw-medium"><%= odontogram_icon(:chevron, css: 'icon od-history-chevron') %><%= odontogram_icon(:records, css: 'icon text-muted') %><%= t('odontogram.recorded_entries') %></summary>
  <% if @entries.empty? %>
    <div class="card-body text-muted"><%= t('odontogram.empty') %></div>
  <% else %>
    <div class="list-group list-group-flush">
      <% @entries.each do |entry| %>
        <div class="list-group-item" data-odontogram-entry="<%= entry.id %>">
          <%= render 'history_marking', entry: entry %>
          <% if entry.state == 'removed' %><span class="d-inline-flex align-items-center gap-1 text-muted small mt-1"><%= odontogram_icon(:remove) %><%= t('odontogram.editor.removed_state') %></span><% end %>
          <div class="text-muted small mt-1"><%= t('odontogram.recorded_by', date: l(entry.created_at, format: :long), name: entry.recorded_by_name) %></div>
          <% if entry.observed_on %>
            <div class="text-muted small"><%= t('odontogram.observed_on', date: l(entry.observed_on, format: :long)) %></div>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @earlier_entries %>
      <div class="card-footer"><%= link_to t('odontogram.earlier_entries'), patient_odontogram_path(@patient, **@history_filters, before: @entries.last.id) %></div>
    <% end %>
  <% end %>
</details>

<% end %>
