<section class="card" id="ai-practice-settings" aria-labelledby="ai-practice-title" tabindex="-1">
  <div class="card-header flex-wrap gap-2">
    <h3 class="card-title d-flex align-items-center" id="ai-practice-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-robot-face me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2" />
        <path d="M9 16c1 .667 2 1 3 1s2 -.333 3 -1M9 7l-1 -4M15 7l1 -4M9 12v-1M15 12v-1" />
      </svg>
      <%= t('ai.practice_settings') %>
    </h3>
    <div class="card-actions">
      <span class="badge <%= @practice.agent_access_enabled? ? 'bg-green-lt' : 'bg-secondary-lt' %>"><%= t(@practice.agent_access_enabled? ? 'ai.enabled' : 'ai.disabled') %></span>
    </div>
  </div>
  <%= form_with model: @practice, url: ai_path, method: :patch, local: true, data: { ai_access_form: true } do |f| %>
    <div class="card-body">
      <%= render 'shared/error_messages', target: @practice %>
      <div class="form-check form-switch mb-2">
        <%= f.check_box :agent_access_enabled, class: 'form-check-input', role: 'switch', aria: { describedby: 'ai-disable-hint' }, data: { ai_access_control: true, ai_access_toggle: true, disable_confirm: t('ai.disable_confirm') } %>
        <%= f.label :agent_access_enabled, t('ai.enable_for_practice'), class: 'form-check-label' %>
      </div>
      <p class="text-secondary small mb-3" id="ai-disable-hint"><%= t('ai.disable_hint') %></p>
      <% unless UserConsent.accepted?(current_user, 'ai_data_processing') %>
        <p class="text-secondary small"><%= t(:consent_ai_disclosure) %></p>
        <label class="form-check mb-3">
          <input type="checkbox" name="consent_ai" value="1" class="form-check-input" data-ai-access-control data-ai-consent <%= 'checked' if params[:consent_ai] == '1' %>>
          <span class="form-check-label"><%= t(:consent_ai_label) %></span>
        </label>
      <% end %>
    </div>
  <% end %>
</section>
