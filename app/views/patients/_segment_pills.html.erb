<nav aria-label="<%= t :patients %>" data-patient-counts-url="<%= segment_counts_patients_path(format: :json) %>">
<ul class="nav nav-pills mb-4 flex-wrap gap-1">
  <li class="nav-item">
    <%= link_to patients_url(segment: 'today'), class: "nav-link d-inline-flex align-items-center gap-2 #{@segment == 'today' ? 'active' : ''}", aria: { current: @segment == 'today' ? 'page' : nil } do %>
      <span><%= t :patients_segment_today %></span>
      <span class="badge <%= @segment == 'today' ? 'bg-primary text-primary-fg' : 'bg-secondary-lt' %>" data-patient-count="today" aria-busy="<%= @today_count.nil? %>" <%= tag.attributes('aria-label': t(:patients_counts_loading)) if @today_count.nil? %>><%= @today_count.nil? ? '…' : @today_count %></span>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to patients_url(segment: 'needs_follow_up'), class: "nav-link d-inline-flex align-items-center gap-2 #{@segment == 'needs_follow_up' ? 'active' : ''}", aria: { current: @segment == 'needs_follow_up' ? 'page' : nil } do %>
      <span><%= t :patients_segment_needs_follow_up %></span>
      <span class="badge <%= @segment == 'needs_follow_up' ? 'bg-primary text-primary-fg' : 'bg-secondary-lt' %>" data-patient-count="needs_follow_up" aria-busy="true" aria-label="<%= t :patients_counts_loading %>">…</span>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to patients_url(segment: 'birthdays'), class: "nav-link d-inline-flex align-items-center gap-2 #{@segment == 'birthdays' ? 'active' : ''}", aria: { current: @segment == 'birthdays' ? 'page' : nil } do %>
      <span><%= t :patients_segment_birthdays %></span>
      <span class="badge <%= @segment == 'birthdays' ? 'bg-primary text-primary-fg' : 'bg-secondary-lt' %>" data-patient-count="birthdays" aria-busy="true" aria-label="<%= t :patients_counts_loading %>">…</span>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to t(:patients_segment_all), patients_url(segment: 'all'), class: "nav-link #{@segment == 'all' ? 'active' : ''}", aria: { current: @segment == 'all' ? 'page' : nil } %>
  </li>
</ul>
</nav>
