alert("<%= j item.errors.full_messages.to_sentence %>");

var errorIDs = new Array();

var errorMessages = new Array();

<% item.errors.each do |error| %>
  errorIDs.push("#<%= error.base.class.to_s.downcase %>_<%= error.attribute %>");
  errorMessages.push("<%= error.message %>");
<% end %>

$('.invalid-feedback').remove();

$.each(errorIDs, function(index, value) {
  $("<div class='invalid-feedback'>" + errorMessages[index] + "</div>").insertAfter(errorIDs[index]);
  $(errorIDs[index]).addClass("is-invalid");
});